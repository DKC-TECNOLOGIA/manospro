# ManosPro — Variables de entorno
# Nunca use o publique uma chave privilegiada com prefixo NEXT_PUBLIC_.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_COUNTRY=AR
NEXT_PUBLIC_DEFAULT_LOCALE=es-AR

# Supabase: chave pública usada pelo app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Provisionamento manual, somente para executar scripts de administração confiáveis.
# Nunca adicione esta chave ao Vercel como NEXT_PUBLIC_ e nunca a versione.
# Prefira a Secret key atual; SUPABASE_SERVICE_ROLE_KEY aceita a chave legado.
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=
# ADMIN_FULL_NAME=
